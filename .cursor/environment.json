{
  "name": "100d Next.js app",
  "install": "NODE_BIN=\"$HOME/.nvm/versions/node/v$(cat .nvmrc)/bin\" && export PATH=\"$NODE_BIN:$PATH\" && \"$NODE_BIN/node\" --version && \"$NODE_BIN/npm\" ci",
  "terminals": [
    {
      "name": "next-dev",
      "command": "NODE_BIN=\"$HOME/.nvm/versions/node/v$(cat .nvmrc)/bin\" && export PATH=\"$NODE_BIN:$PATH\" && \"$NODE_BIN/npm\" run dev"
    }
  ],
  "ports": [
    {
      "name": "Next.js dev server",
      "port": 3000
    }
  ]
}
